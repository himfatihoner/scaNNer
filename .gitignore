# Compiled binary (anchored to the repo root ONLY — an unanchored "scanner"
# would also match the cmd/scanner/ SOURCE directory and drop it from the repo).
/scanner

# Local runtime state — the SQLite scan database holds real target/scan data
# and secrets (API keys, SMTP password). NEVER commit it.
/data/scanner.db
/data/scanner.db-shm
/data/scanner.db-wal
*.db
*.db-shm
*.db-wal

# Auto-generated self-signed TLS material
/data/tls/

# Downloaded CVE feeds (large, per-machine)
/data/cve/
/data/nvd/

# Generated per-language direnum wordlists — large (hundreds of MB), built
# locally by scripts/build-direnum-wordlists.sh. Only the generator, the
# curated scripts/direnum-seeds/*.txt, SOURCES.md and manifest.json ship; the
# heavy .gz tiers are per-machine and regenerated on demand.
/data/direnum-wordlists/*.txt.gz
/data/direnum-wordlists/_synthetic/
/data/direnum-wordlists/_cache/

# Externally-installed third-party tool binaries (users install these
# themselves; the Docker image builds them). Do not vendor binaries.
/tools/*
!/tools/.gitkeep

# Logs
*.log

# Local editor / agent / OS cruft
.claude/
.idea/
.vscode/
.DS_Store

# Internal/working docs — not for the public repo
AUDIT_REPORT*.md
PENTEST_PLAN.txt

# Stray test artifacts (cookie/session values accidentally used as filenames)
scanner_session*
*.cookie

# python
__pycache__/
*.pyc
